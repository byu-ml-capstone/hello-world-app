# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored - never commit real tokens.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   $EDITOR terraform.tfvars
#   terraform init
#   terraform apply

# ---------------------------------------------------------------------------
# 1) Coolify API token
# ---------------------------------------------------------------------------
# Create at https://ml-capstone-admin.cs.byu.edu
# -> click the Coolify wordmark top-left to go to the instance dashboard
# -> left sidebar: Keys & Tokens -> API Tokens -> + New Token
# -> Description: `terraform-lab` (or anything)
# -> Permissions: check `root` (or check all of view + create + deploy + delete)
# -> Create -> COPY IMMEDIATELY (Coolify shows the token exactly once)
# -> paste below.
coolify_token = "REPLACE_ME"

# ---------------------------------------------------------------------------
# 2) GitHub Personal Access Token
# ---------------------------------------------------------------------------
# You need a token with `repo` scope so Terraform can look up your repo AND
# write GitHub Actions secrets onto it. Two ways to get one:
#
# EASY (if you have the GitHub CLI installed):
#   gh auth token
# Copy the output. Format is `ghp_...` or `gho_...` (~40 chars).
#
# UI PATH (if you don't have `gh`):
#   1. Log in to github.com
#   2. Click your avatar (top-right) -> Settings
#   3. Scroll to the bottom of the left sidebar -> Developer settings
#   4. Personal access tokens -> Tokens (classic)
#   5. Generate new token -> Generate new token (classic)
#   6. Note: `terraform-coolify-lab` (or anything)
#   7. Expiration: 30 days (or 90; avoid "no expiration" - security foot-gun)
#   8. Scopes: check the TOP-LEVEL `repo` box (includes all sub-checkboxes)
#   9. Scroll to bottom -> Generate token
#  10. COPY IMMEDIATELY (GitHub only shows it once) -> paste below.
github_token = "REPLACE_ME"

# ---------------------------------------------------------------------------
# 3) Your repo name -- JUST the repo name, NOT the org prefix.
# ---------------------------------------------------------------------------
# If your GitHub repo lives at https://github.com/byu-ml-capstone/qsnell-hello
# then put ONLY `qsnell-hello` here. The `byu-ml-capstone/` org prefix comes
# from the `github_org` variable and gets prepended automatically.
#
#   Wrong: repo_name = "byu-ml-capstone/qsnell-hello"   <- BAD (doubles up)
#   Right: repo_name = "qsnell-hello"                    <- GOOD
#
# This value is also used as your Coolify Project name and the base for
# staging + prod domains:
#   staging: http://<repo_name>-staging.ml-capstone.cs.byu.edu
#   prod:    http://<repo_name>.ml-capstone.cs.byu.edu
repo_name = "REPLACE_ME"

# ---------------------------------------------------------------------------
# 4) (Optional) Overrides for forking to a different setup
# ---------------------------------------------------------------------------
# Everything below has a default matching the BYU ml-capstone class, so
# class students don't need to touch any of it. Uncomment + change only
# if you're using this template outside the class:
#
#   * different GitHub org (or a personal account)
#   * your own Coolify install
#   * your own hardware / different Docker network
#
# github_org       = "byu-ml-capstone"
# coolify_endpoint = "https://ml-capstone-admin.cs.byu.edu/api/v1"
# app_domain_base  = "ml-capstone.cs.byu.edu"
